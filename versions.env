# Every pinned version of this project in one place. Read (sourced) by scripts/00-fetch-sources.sh,
# kernels/debian/build.sh and kernels/mainline/build.sh. Change a version here, nowhere else.
# Plain shell assignments only (no commands): this file is also read by the docs.

# --- cross compilers: kernel.org crosstool, no libc
GCC_VERSION=11.5.0

# --- bootloader + T3 kernel sources: <git url> <branch or tag> <exact commit>
UBOOT="https://github.com/t3gemstone/u-boot.git v2025.04-rc3-t3-gem-o1 b8410d78120ed91156f3ec7ede81bed004f8b46e"
T3_LINUX="https://github.com/t3gemstone/linux.git v6.12.24-ti-arm64-r43-t3-gem-o1 6267aeaee46f09c9550cf135c6041970c973d7c0"
TFA="https://github.com/TrustedFirmware-A/trusted-firmware-a.git lts-v2.12.4 a9fcaf3ccf3c0091c33ba6ef03b8ed629394c240"
OPTEE="https://github.com/OP-TEE/optee_os.git 4.6.0 71785645fa6ce42db40dbf5a54e0eaedc4f61591"
TI_FIRMWARE="https://github.com/beagleboard/ti-linux-firmware.git 11.01.03 e594deb508a322d5681888d48fbb153953b06ca9"

# --- Debian kernel (kernels/debian): Debian's source package from trixie-backports
DEBIAN_KERNEL_DEBVER=7.2.12-1~bpo13+1      # Debian source version
DEBIAN_KERNEL_ABI=7.2.12+deb13-arm64       # Debian binary flavour (only used to fetch its config)
DEBIAN_KERNEL_PKGVER=7.2.12-1gemstone1     # version of our .deb
# name, sha1 (address on snapshot.debian.org), sha256 (checked)
DEBIAN_KERNEL_PINNED="
linux_7.2.12-1~bpo13+1.dsc 08c47d4d1a697f242770e7d7091a7e8124129f41 fa6339804faaaaee70eb9d2d8717c7a49181e862cbccdcfbf6432f62c0b85d9c
linux_7.2.12.orig.tar.xz ae243032a23f2faa6366c328986756ed3b356d68 f348e721511f17dc41343b147ab0252382a62d3c4633ff88007b025bd99ce71d
linux_7.2.12-1~bpo13+1.debian.tar.xz 63ada23ebd8451c78b39fb7edb4ab3f914e839f1 7d38a855137e9ec66e645d4e9454802bae162bca85c27c5b2c2ed84889197c5d
linux-base-7.2.12+deb13-arm64_7.2.12-1~bpo13+1_arm64.deb bd7877bd6b337fa4c2dbd498ac83b58214c80f62 d27ed36fda0b152181fe4258bf5739d299821a9a7276566bb6c234f4bfc0e9b7
"

# --- Debian trixie kernel (kernels/trixie, kernels/trixie-hdmi): the 6.12 kernel Pardus 25 uses,
# Debian's source package from trixie-security. Update: newest "linux" version in
# security.debian.org/debian-security/dists/trixie-security/main/source/Sources.xz, its 3 source files
# and linux-image-<abi>-unsigned_<ver>_arm64.deb (for the config): sha1 + sha256 of each file.
TRIXIE_KERNEL_DEBVER=6.12.118-1
TRIXIE_KERNEL_ABI=6.12.118+deb13-arm64
TRIXIE_KERNEL_PKGVER=6.12.118-1gemstone1
TRIXIE_KERNEL_PINNED="
linux_6.12.118-1.dsc 058924c17cfd752c1cc08f126335a2b419e498fb c0d49c11a1121881a1bdec865a6c980ba500aaf46fdd8c1a80d998ec5b2b41da
linux_6.12.118.orig.tar.xz 33272070fcb12bee01692d99d4e116f330b86efb f2ea408932fc885642003e5e38c0907e9f76947f1cd62674655d9a0d54c0c992
linux_6.12.118-1.debian.tar.xz 0a714c401d60331df96712f5d92f9b5543731ad0 b7d97f5313ee73c35f6c64f18c4810a2872e329f63de143d3043ef29330984f5
linux-image-6.12.118+deb13-arm64-unsigned_6.12.118-1_arm64.deb 9aa8a0782c52d2c8848f15a765c54be9ef833acd 05a4f577a8d159d7a6b5838d9c0276752818ed60630f59e78be39bb472cf567a
"

# --- mainline kernel (kernels/mainline): kernel.org tarball, no patches.
# Longterm (LTS) 6.18: newest LTS, projected EOL Dec 2028 (kernel.org/category/releases.html).
# Update: next 6.18.y number + its line from cdn.kernel.org/pub/linux/kernel/v6.x/sha256sums.asc
MAINLINE_VERSION=6.18.64
MAINLINE_SHA256=020d45510c539972e6f14c5c71566878d3b7ef56fb082b3e09134f2ebaade562   # cdn.kernel.org sha256sums.asc
MAINLINE_PKGVER=6.18.64-1gemstone1

# --- stable kernel (kernels/stable, kernels/stable-hdmi): kernel.org stable 7.3, the newest release.
# NOT longterm: kernel.org ends the 7.3 series a few weeks after 7.4 comes out.
# Update: next 7.3.y + its line from cdn.kernel.org/pub/linux/kernel/v7.x/sha256sums.asc
STABLE_VERSION=7.3.5
STABLE_SHA256=8f293f83d54f0b7b9be56863ebc5e4ea79d73e530b4ae55c572be97ef39f0990    # cdn.kernel.org sha256sums.asc
STABLE_PKGVER=7.3.5-1gemstone1
