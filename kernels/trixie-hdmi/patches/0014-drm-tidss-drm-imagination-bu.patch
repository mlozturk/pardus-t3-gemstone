diff --git a/drivers/gpu/drm/tidss/tidss_compat612.h b/drivers/gpu/drm/tidss/tidss_compat612.h
new file mode 100644
index 000000000..7cbb9b76f
--- /dev/null
+++ b/drivers/gpu/drm/tidss/tidss_compat612.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * T3 Gemstone O1 / Debian trixie: the 6.18 tidss driver on a 6.12 kernel.
+ * devm_drm_bridge_alloc() (6.16) does not exist in 6.12: allocate the
+ * containing struct with devm_kzalloc() and set the bridge funcs, which is
+ * what drivers did in 6.12.
+ */
+#ifndef __TIDSS_COMPAT612_H__
+#define __TIDSS_COMPAT612_H__
+
+#include <linux/auxiliary_bus.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/slab.h>
+
+/* auxiliary_device_destroy() (6.16): same two calls as in drivers/base/auxiliary.c */
+static inline void tidss_auxiliary_device_destroy(void *auxdev)
+{
+	auxiliary_device_delete(auxdev);
+	auxiliary_device_uninit(auxdev);
+}
+#define auxiliary_device_destroy tidss_auxiliary_device_destroy
+
+#ifndef devm_drm_bridge_alloc
+#define devm_drm_bridge_alloc(dev, type, member, f) ({			\
+	type *__p = devm_kzalloc(dev, sizeof(type), GFP_KERNEL);	\
+	if (__p)							\
+		__p->member.funcs = (f);				\
+	__p ? __p : (type *)ERR_PTR(-ENOMEM);				\
+})
+#endif
+
+#endif /* __TIDSS_COMPAT612_H__ */
