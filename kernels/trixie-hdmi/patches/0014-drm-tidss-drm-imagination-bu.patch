+/* 6.12: drm_sched_job_has_dependency() (6.17) does not exist; same check on the job's xarray */
+static bool drm_sched_job_has_dependency(struct drm_sched_job *job, struct dma_fence *fence)
+{
+	struct dma_fence *f;
+	unsigned long index;
+
+	xa_for_each(&job->dependencies, index, f) {
+		if (f == fence)
+			return true;
+	}
+	return false;
+}
